
# Copy this file to .env and fill in real values.
# .env is never committed.

APP_NAME=aquiferask
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Paste your Neon connection string here, in .env only.
# It starts with postgresql://
DATABASE_URL=postgresql://localhost:5432/aquiferask


# LLM keys (Day 8)
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

REDIS_URL=redis://localhost:6379
ADMIN_TOKEN=
